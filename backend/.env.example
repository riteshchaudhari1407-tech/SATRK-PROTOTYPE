# ============================================================
# Satrk backend configuration
# Copy this file to ".env" (same folder) and fill in real values.
# ".env" should NEVER be committed to git.
# ============================================================

# --- Groq LLM (Layer B) ---
# Get a free key at https://console.groq.com/keys
# PASTE YOUR REAL KEY BELOW — this file (.env) stays on the server only,
# it is never sent to or read by the frontend/browser.
GROQ_API_KEY=

# Check https://console.groq.com/docs/models for the current list of
# active models — Groq periodically retires older model IDs.
GROQ_MODEL=openai/gpt-oss-20b

GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2

# --- Semantic AI (Layer A) ---
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- CORS: comma-separated list of allowed frontend origins ---
FRONTEND_ORIGINS=http://localhost:5173

# --- Input limits ---
MAX_TEXT_LENGTH=4000
MAX_IMAGE_SIZE_MB=8

# --- Health check cache duration (seconds) ---
HEALTH_CACHE_SECONDS=45
